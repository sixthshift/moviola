{
  "name": "moviola",
  "version": "0.1.0",
  "description": "The scrollytelling framework — you write the DOM, moviola runs the state machine, effects live in your CSS.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sixthshift/moviola.git"
  },
  "homepage": "https://github.com/sixthshift/moviola#readme",
  "bugs": {
    "url": "https://github.com/sixthshift/moviola/issues"
  },
  "main": "./dist/moviola.esm.js",
  "types": "./dist/moviola.d.ts",
  "exports": {
    ".": {
      "types": "./dist/moviola.d.ts",
      "default": "./dist/moviola.esm.js"
    },
    "./moviola.css": "./dist/moviola.css",
    "./dist/*": "./dist/*"
  },
  "files": [
    "dist",
    "src",
    "themes"
  ],
  "sideEffects": false,
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "bun run build && playwright test",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "format": "biome format --write .",
    "check": "bun run typecheck && bun run lint && bun run test && bun run test:e2e && node scripts/check-links.mjs && git diff --exit-code dist examples skill/assets"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.2",
    "@microsoft/api-extractor": "^7.58.9",
    "@playwright/test": "^1.61.1",
    "esbuild": "^0.28.1",
    "happy-dom": "^20.10.6",
    "typescript": "^6.0.3",
    "vite": "^8.1.3",
    "vite-plugin-dts": "^5.0.3",
    "vitest": "^4.1.9"
  }
}
